{
  "name": "docs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run --name docs.taxkit vite dev",
    "build": "bun run --filter=@taxkit/docs-fumadocs build && vite build",
    "check-types": "bun run --filter=@taxkit/docs-fumadocs build && tsc --noEmit",
    "clean": "rm -rf .output .tanstack .turbo node_modules/.vite",
    "check-import-boundaries": "bun run ./scripts/check-import-boundaries.ts",
    "preview": "portless run --name docs.taxkit vite preview",
    "test": "vitest run --config vitest.server.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:built": "bun run build && bun run ./scripts/test-built.tsx"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@taxkit/docs-content": "workspace:*",
    "@taxkit/docs-fumadocs": "workspace:*",
    "effect": "catalog:",
    "fumadocs-mdx": "^14.3.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "4.1.7",
    "nitro": "catalog:",
    "playwright": "^1.60.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
