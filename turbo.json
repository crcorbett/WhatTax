{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".source/**", ".output/**", ".vercel/output/**"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "inputs": [
        "content/**",
        "navigation.json",
        "source.config.ts",
        "src/schemas.ts",
        "package.json"
      ],
      "outputs": [".source/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
