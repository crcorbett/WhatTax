{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/repository-accepted-findings.v1.json",
  "title": "Accepted audit finding crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditId", "targetRevision", "entries"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "auditId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
    "targetRevision": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "requirementIds",
          "taskIds",
          "owningPaths",
          "verification",
          "proof"
        ],
        "properties": {
          "findingId": { "type": "string", "pattern": "^HE-[0-9]{3}$" },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "taskIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "owningPaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "proof": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
