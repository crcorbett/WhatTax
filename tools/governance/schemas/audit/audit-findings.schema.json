{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/repository-audit-findings.v1.json",
  "title": "Repository audit findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditId",
    "targetRevision",
    "findings",
    "foundationsToPreserve",
    "limitations",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "auditId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
    "targetRevision": { "$ref": "#/$defs/nonEmptyString" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "foundationsToPreserve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "evidence", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^PRESERVE-[0-9]{3}$" },
          "summary": { "$ref": "#/$defs/nonEmptyString" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "owner": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "nonClaims": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "lineStart", "lineEnd", "observation"],
        "properties": {
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "lineStart": { "type": ["integer", "null"], "minimum": 1 },
          "lineEnd": { "type": ["integer", "null"], "minimum": 1 },
          "observation": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "surfaceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evidence"],
      "properties": {
        "decision": {
          "enum": ["change_required", "preserve", "not_applicable"]
        },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs",
        "readmes",
        "architecture_standards",
        "runbooks",
        "proof_evidence",
        "skills",
        "lint_config_ci",
        "spec_tasks",
        "tests_fixtures",
        "config_exports",
        "lifecycle",
        "release_rollback",
        "critical_journeys"
      ],
      "properties": {
        "docs": { "$ref": "#/$defs/surfaceDecision" },
        "readmes": { "$ref": "#/$defs/surfaceDecision" },
        "architecture_standards": { "$ref": "#/$defs/surfaceDecision" },
        "runbooks": { "$ref": "#/$defs/surfaceDecision" },
        "proof_evidence": { "$ref": "#/$defs/surfaceDecision" },
        "skills": { "$ref": "#/$defs/surfaceDecision" },
        "lint_config_ci": { "$ref": "#/$defs/surfaceDecision" },
        "spec_tasks": { "$ref": "#/$defs/surfaceDecision" },
        "tests_fixtures": { "$ref": "#/$defs/surfaceDecision" },
        "config_exports": { "$ref": "#/$defs/surfaceDecision" },
        "lifecycle": { "$ref": "#/$defs/surfaceDecision" },
        "release_rollback": { "$ref": "#/$defs/surfaceDecision" },
        "critical_journeys": { "$ref": "#/$defs/surfaceDecision" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "invariantIds",
        "priority",
        "risk",
        "evidence",
        "lifecycleOrDecision",
        "semanticOwner",
        "proofGap",
        "rootCorrection",
        "retire",
        "surfaces",
        "verification",
        "journeyIds",
        "authorityOrDecision",
        "limitations",
        "nonClaims",
        "decision"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^HE-[0-9]{3}$" },
        "invariantIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^HC-[A-Z]+-[0-9]{3}$" }
        },
        "priority": {
          "enum": ["important_correction", "optional_improvement"]
        },
        "risk": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "lifecycleOrDecision": { "$ref": "#/$defs/nonEmptyString" },
        "semanticOwner": { "$ref": "#/$defs/nonEmptyString" },
        "proofGap": { "$ref": "#/$defs/nonEmptyString" },
        "rootCorrection": { "$ref": "#/$defs/nonEmptyString" },
        "retire": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "surfaces": { "$ref": "#/$defs/surfaces" },
        "verification": { "$ref": "#/$defs/nonEmptyStrings" },
        "journeyIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "authorityOrDecision": { "$ref": "#/$defs/nonEmptyString" },
        "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
        "nonClaims": { "$ref": "#/$defs/nonEmptyStrings" },
        "decision": {
          "enum": ["proposed", "accepted", "rejected", "deferred", "optional"]
        }
      }
    }
  }
}
