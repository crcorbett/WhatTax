{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/repository-audit-scope.v1.json",
  "title": "Repository audit scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profile",
    "target",
    "lifecyclePhase",
    "acceptedLocalDecisions",
    "externalObservations",
    "claimedJobs",
    "representativeJourneyIds",
    "acceptedOutcomes",
    "proofBoundaries",
    "inventoryGroups",
    "deepReads",
    "authority",
    "exclusions",
    "stopConditions",
    "limitations",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
    "profile": { "$ref": "#/$defs/nonEmptyString" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "revision",
        "branch",
        "upstream",
        "worktreeState",
        "observedAt"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "$ref": "#/$defs/nonEmptyString" },
        "branch": { "type": ["string", "null"] },
        "upstream": { "type": ["string", "null"] },
        "worktreeState": { "enum": ["clean", "dirty", "not_versioned"] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lifecyclePhase": { "$ref": "#/$defs/nonEmptyString" },
    "acceptedLocalDecisions": { "$ref": "#/$defs/nonEmptyStrings" },
    "externalObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "observedAt", "receipt", "nonClaim"],
        "properties": {
          "system": { "$ref": "#/$defs/nonEmptyString" },
          "observedAt": { "type": "string", "format": "date-time" },
          "receipt": { "$ref": "#/$defs/nonEmptyString" },
          "nonClaim": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "claimedJobs": { "$ref": "#/$defs/nonEmptyStrings" },
    "representativeJourneyIds": { "$ref": "#/$defs/nonEmptyStrings" },
    "acceptedOutcomes": { "$ref": "#/$defs/nonEmptyStrings" },
    "proofBoundaries": { "$ref": "#/$defs/nonEmptyStrings" },
    "inventoryGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selection", "count", "artifact", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "selection": { "$ref": "#/$defs/nonEmptyString" },
          "count": { "type": "integer", "minimum": 0 },
          "artifact": { "$ref": "#/$defs/nonEmptyString" },
          "status": {
            "enum": ["accounted", "partial", "inaccessible", "not_applicable"]
          }
        }
      }
    },
    "deepReads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "classification": {
            "enum": [
              "current",
              "canonical",
              "affected",
              "contradictory",
              "generated_owner",
              "historical_evidence",
              "trajectory_evidence"
            ]
          },
          "reason": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection",
        "localMutation",
        "externalAccess",
        "approvalReceipt"
      ],
      "properties": {
        "inspection": { "const": "read_only" },
        "localMutation": { "type": "boolean" },
        "externalAccess": { "enum": ["none", "read_only", "mutation"] },
        "approvalReceipt": { "type": ["string", "null"] }
      }
    },
    "exclusions": { "$ref": "#/$defs/nonEmptyStrings" },
    "stopConditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "nonClaims": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
